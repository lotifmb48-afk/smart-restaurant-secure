# Copy this file to .env and replace every placeholder with private values.
NODE_ENV=development
PORT=3000
DATABASE_FILE=./data/restaurant.sqlite

# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_unique_random_secret_at_least_32_characters

# Real administrator account (never publish these values).
ADMIN_USERNAME=replace_with_real_admin_username
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# Optional read-only demo account used by the Admin Demo Login button.
DEMO_ADMIN_USERNAME=replace_with_demo_username
DEMO_ADMIN_PASSWORD=replace_with_a_separate_demo_password_at_least_12_characters
